{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/nmat-exam run build",
  "outputDirectory": "artifacts/nmat-exam/dist/public",
  "framework": null,
  "headers": [
    {
      "source": "/questions/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
